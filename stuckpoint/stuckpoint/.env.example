# Copy to .env and fill in. Never commit .env.

# Gemma 4 via the Gemini API (key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-31b-it            # fallback: gemma-4-26b-a4b-it (faster)

# Activity source: live (Activity Frames capture) | fixture (sample data)
STUCKPOINT_SOURCE=live
STUCKPOINT_FIXTURE=fixtures/sample_frames.json
AFRAMES_DB=                            # optional: force a specific capture DB

# Cross-platform recorder: python -m stuckpoint record  (Windows / Linux / macOS)
RECORDER_DB=~/.activity-frames/stuckpoint-capture.sqlite
RECORDER_POLL_S=2
RECORDER_HEARTBEAT_S=10
RECORDER_IDLE_S=600

# Local app database
STUCKPOINT_DB=stuckpoint.db

# Stuck detection (use STUCK_THRESHOLD_MIN=3 for the live demo)
STUCK_THRESHOLD_MIN=15
LOOP_THRESHOLD=3
LOW_INPUT_MIN=10
LOW_INPUT_KPM=8
WINDOW_MIN=30
CHECK_INTERVAL_S=60
COOLDOWN_MIN=10
SNOOZE_MIN=15
