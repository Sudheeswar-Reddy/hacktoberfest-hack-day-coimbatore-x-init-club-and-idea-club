{
  "manifest_version": 3,
  "name": "StuckPoint",
  "version": "0.1.0",
  "description": "Activity-aware hints and evidence-backed code suggestions.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "notifications", "alarms", "sidePanel", "tabs"],
  "host_permissions": ["http://127.0.0.1:8765/*", "<all_urls>"],
  "background": {"service_worker": "background.js"},
  "side_panel": {"default_path": "sidepanel/sidepanel.html"},
  "action": {"default_title": "StuckPoint"},
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/tracker.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content/editor_bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content/editor_ui.js"],
      "css": ["content/highlight.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {"128": "icons/icon128.png"}
}
