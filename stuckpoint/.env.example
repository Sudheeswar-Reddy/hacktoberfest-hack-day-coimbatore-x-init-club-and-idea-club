# Copy to .env and fill in. Never commit .env.

# Gemma 4 via the Gemini API (key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-31b-it            # fallback: gemma-4-26b-a4b-it (faster)
GEMMA_THINKING=minimal                # minimal = fast replies; "default" = let the model think longer
LLM_TIMEOUT_S=30

# Local engine the Chrome / VS Code extensions talk to
ENGINE_HOST=127.0.0.1
ENGINE_PORT=8765

# Activity source: live (extensions / recorder -> capture DB) | fixture (sample data)
STUCKPOINT_SOURCE=live
STUCKPOINT_FIXTURE=fixtures/sample_frames.json
# Capture DB in Activity Frames' schema, written by the engine from extension events.
# Leave empty to auto-pick the most recent of data/capture.sqlite and nocta's DB (macOS aframes record).
AFRAMES_DB=

# Local app database (signals, hints, solved marks, report)
STUCKPOINT_DB=data/stuckpoint.db

# Stuck detection (use STUCK_THRESHOLD_MIN=3 for the live demo)
STUCK_THRESHOLD_MIN=15
LOOP_THRESHOLD=3
LOW_INPUT_MIN=10
LOW_INPUT_KPM=8
WINDOW_MIN=30
CHECK_INTERVAL_S=60
COOLDOWN_MIN=10
SNOOZE_MIN=15

# Skills report
REPORT_DAYS=7
SUGGEST_MAX_LINES=300

# Optional OS-level recorder (python -m stuckpoint record), Windows / macOS / Linux.
# Writes into the same capture DB. Use it OR the extensions, not both (input would be counted twice).
RECORDER_POLL_S=2
RECORDER_HEARTBEAT_S=10
RECORDER_IDLE_S=600
